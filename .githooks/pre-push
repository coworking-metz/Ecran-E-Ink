#!/usr/bin/env bash
# Avant chaque push : refuse d'envoyer un commit qui contient polices, secrets, notes locales ou chaînes interdites.
# Activé par `npm install` (script prepare : git config core.hooksPath .githooks).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # suppression de branche
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  node scripts/check-public.mjs --range "$range" || { echo "push annulé par scripts/check-public.mjs"; exit 1; }
done
