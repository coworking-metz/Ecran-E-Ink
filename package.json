{
  "name": "eink",
  "private": true,
  "workspaces": [
    "server",
    "admin"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:admin",
    "dev:server": "npm run dev -w server",
    "dev:admin": "npm run dev -w admin",
    "build": "npm run build -w admin",
    "start": "npm run build && npm run start -w server",
    "test": "node --test \"server/test/*.test.js\"",
    "check": "node scripts/check-public.mjs && npm run build && npm test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
