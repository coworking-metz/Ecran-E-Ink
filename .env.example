# Copier en .env (ignoré par git)
ADMIN_PASSWORD=change-me        # utilisé seulement si le SSO ci-dessous n'est pas configuré
EINK_PORT=3000
# EINK_HOST=127.0.0.1   # adresse d'écoute (défaut : boucle locale, derrière un reverse proxy)
# DATA_DIR=./server/data

# --- SSO WordPress (Authorization Code + PKCE, client public : aucun secret client) ---
# Si WP_URL, WP_CLIENT_ID et SESSION_SECRET sont renseignés, la connexion par mot de passe est désactivée.
# WP_URL=https://www.coworking-metz.fr
# WP_CLIENT_ID=<client_id du client « Ecrans e-ink (admin) » dans WP OAuth Server>
# PUBLIC_URL=http://localhost:5173      # URL de l'admin vue par le navigateur ; redirect_uri = PUBLIC_URL/api/auth/callback
# SESSION_SECRET=<openssl rand -hex 32>
# SESSION_DAYS=1                        # durée de la session (défaut 1 jour)
